{
  "name": "pizzagram-dev",
  "version": "1.0.0",
  "description": "Strumenti di sviluppo di Pizzagram: regole Firebase, build SDK, test",
  "scripts": {
    "build": "node build.mjs",
    "emulators": "firebase emulators:start --project demo-pizzagram",
    "test:rules": "firebase emulators:exec --project demo-pizzagram --only firestore,storage \"node --test tests/rules.test.mjs\"",
    "dev": "firebase emulators:exec --project demo-pizzagram --only auth,firestore,storage \"node dev-server.mjs\"",
    "icons": "node icons.mjs",
    "test:e2e": "firebase emulators:exec --project demo-pizzagram --only auth,firestore,storage \"node --test tests/e2e.test.mjs\"",
    "print": "node print/qr.mjs $npm_config_code && node print/poster.mjs $npm_config_code"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "jsqr": "^1.4.0",
    "playwright": "1.56",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "private": true,
  "type": "module"
}
